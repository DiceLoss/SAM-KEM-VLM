# Large binary outputs (kept in D:/MIAProject/SAM_KEM_v3_checkpoints/ and D:/MIAProject/SAM_KEM_QWEN3_AUDIT_ONLY_20260823.tar.gz)
*.pt
*.pth
*.egg
*.pkl
*.pdf
*.tar.gz
*.zip
external/
staging/
runs/*/hyperparameter_sweep_shards/
runs/*/hyperparameter_sweep/
runs/*/.hyperparameter_sweep.merge.*/
runs/*/hyperparameter_expansion_shards/
runs/*/hyperparameter_expansion/
runs/*/.hyperparameter_expansion.merge.*/
