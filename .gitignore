logs/gpu_*.log
# Superseded local output from the interrupted Step 4C batch. Its immutable
# incident decision and forensic summaries are tracked separately.
logs/step4c_full.log
logs/step4c_full_audit.json

# Raw BrainWeb nii.gz (large, kept in D:/MIAProject/brainweb/)
data/raw/*.nii.gz

# Per-slice sinograms and SAM priors (large, kept in D:/MIAProject/SAM_KEM_QWEN3_MEDSAM2_DELIVERY/arrays/)
data/processed/

# Clean-run bulk arrays and rendered prompt pixels live in the immutable
# external artifact archive. Their SHA-bound JSON/CSV manifests remain tracked.
arrays/clean_v1/
arrays/*/
prompts/*/train_validation_images/**/*.png
prompts/*/test_images/**/*.png
# Per-image render sidecars are bulk artifacts archived with their PNGs.
# Root prompt manifests and their CSV sidecars remain tracked.
prompts/*/train_validation_images/*/*/*/*.json
prompts/*/test_images/*/*/*/*.json
# Raw Qwen attempt documents are required in the immutable external archive;
# only the response _SUCCESS marker, cache CSV, and audit summaries belong in Git.
# Include incident-resolved continuation directories while leaving their root
# _SUCCESS marker trackable.
prompts/*/train_validation_responses*/*/*/*/*.json
prompts/*/test_responses/*/*/*/*.json
prompts/*/qwen_pilot_attempts/*/*/*/*.json

# Python caches
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Offline transfer bundle (optional)
v3_repo_complete.bundle

# Allow small per-dataset sample NPZ files for reproducibility
# (these are < 50 MB each, intentionally committed so reviewers
# can reproduce single cases without the full array tree)
!data/samples/*.npz
!data/samples/*.json

# Allow raw PET inputs (BW true_pet volumes + HE PET channel)
# These are the actual scanner-faithful inputs the v3 pipeline started from.
!data/raw_pet/*.npz
!data/raw_pet/*.json

# Allow small traceability samples (a few subjects × one slice each)
!data/raw_samples/*.npz
!data/raw_samples/*.json

# This one verified bundle is deliberately published through Git LFS. Other
# ZIP/checkpoint files remain ignored and belong to external artifact storage.
!delivery/dev_trainmax_v1_decoder_bundle.zip
!delivery/dev_trainmax_v1_validation_priors.zip
