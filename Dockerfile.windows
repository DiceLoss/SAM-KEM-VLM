# Historical filename retained for compatibility. This image validates the
# platform-independent scientific core; GPU training uses a separately locked
# image after the exact MedSAM2 commit and CUDA/PyTorch pair are recorded.
FROM python:3.11.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY code ./code
COPY tests ./tests
RUN python -m pip install --upgrade pip && \
    python -m pip install '.[test,evaluation]'

CMD ["python", "-m", "pytest"]
