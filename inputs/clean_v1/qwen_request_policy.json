{
  "schema_version": 1,
  "policy_id": "qwen3_vl_plus_fixed_retry_v2",
  "endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
  "temperature": 0,
  "timeout_seconds": 120,
  "max_attempts_per_key": 3,
  "backoff_seconds_before_attempt": [0.0, 2.0, 8.0],
  "retry_scope": "transport_retryable_http_response_parse_and_box_validation_errors",
  "retryable_http_statuses": [408, 409, 425, 429],
  "retryable_http_status_classes": [5],
  "nonretryable_http_action": "archive_one_attempt_and_abort_batch_without_fallback",
  "max_consecutive_live_failed_keys": 10,
  "archive_every_attempt": true,
  "selection_policy": "identical_for_every_cache_key_no_selective_retry",
  "terminal_failure_action": "record_exhausted_retryable_failure_then_centroid_fallback_at_cache_build"
}
